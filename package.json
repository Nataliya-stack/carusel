{
  "name": "proyecto-components",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
  "dev": "concurrently -n \"astro,json\" -c \"bgBlue,bgGreen\" \"pnpm astro dev\" \"npx json-server --watch db.json --host 127.0.0.1 --port 3000\"",
  "start": "pnpm dev",
  "build": "astro build",
  "preview": "astro preview",
  "astro": "astro",
  "predeploy": "pnpm build",
  "deploy": "gh-pages -d dist --filter ."
},
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.6",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "concurrently": "^10.0.3",
    "gh-pages": "^6.3.0",
    "tailwindcss-animate": "^1.0.7"
  }
}