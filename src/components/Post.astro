---
const { ciudad: { name, image, info } } = Astro.props;
---

<!-- Обновленный тег <article> с круговой тенью со всех сторон -->
<article class="flex max-w-sm flex-col gap-4 rounded-xl bg-brand-rose p-6 text-brand-wine shadow-[0_0_45px_15px_rgba(0,0,0,0.3)] transition-all duration-300 ease-out hover:-translate-y-2 hover:scale-[1.02] hover:shadow-[0_0_25px_var(--color-brand-glow)]">
  <img class="rounded-lg w-full h-48 object-cover shadow-sm" src={image} alt={name}>  
  <h2 class="font-card text-3xl font-black tracking-widest mt-1 border-b border-brand-wine/10 pb-2">
    {name}
  </h2>
  <ul class="list-none space-y-2 text-base font-medium opacity-90">
    {info.map((text: string) => (
      <li class="flex items-start gap-2">
        <span class="text-brand-wine/70 select-none">✦</span>
        <span>{text}</span>
      </li>
    ))}
  </ul>
</article>


